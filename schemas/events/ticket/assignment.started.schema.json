{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/ticket/assignment.started.schema.json",
  "title": "assignment.started",
  "description": "assignment.started",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "assignment.started"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "type": "string",
          "x-id-prefix": "as"
        },
        "ticket_id": {
          "type": "string",
          "x-id-prefix": "tk"
        },
        "executor_kind": {
          "type": "string",
          "enum": [
            "builtin",
            "codex",
            "claude_code",
            "dsh"
          ]
        },
        "session_ref": {
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "ticket_id",
        "executor_kind"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

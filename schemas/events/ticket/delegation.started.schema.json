{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/ticket/delegation.started.schema.json",
  "title": "delegation.started",
  "description": "delegation.started",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "delegation.started"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "type": "string",
          "x-id-prefix": "dg"
        },
        "team_id": {
          "type": "string"
        },
        "parent_run_id": {
          "type": "string",
          "x-id-prefix": "rn"
        },
        "member_agent_id": {
          "type": "string"
        },
        "child_thread_id": {
          "type": "string",
          "x-id-prefix": "th"
        },
        "dedupe_key": {
          "type": "string"
        }
      },
      "required": [
        "delegation_id",
        "team_id",
        "parent_run_id",
        "member_agent_id",
        "dedupe_key"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

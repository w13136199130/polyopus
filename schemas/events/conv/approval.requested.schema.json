{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/conv/approval.requested.schema.json",
  "title": "approval.requested",
  "description": "approval.requested",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "approval.requested"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "type": "string",
          "x-id-prefix": "ap"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Action"
          }
        },
        "allowed_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "approve",
              "approve_session",
              "deny"
            ]
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "actions",
        "allowed_decisions",
        "expires_at",
        "summary"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

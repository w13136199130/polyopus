{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/conv/turn.finished.schema.json",
  "title": "turn.finished",
  "description": "Terminal state of a turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "turn.finished"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "type": "string",
          "x-id-prefix": "tu"
        },
        "run_id": {
          "type": "string",
          "x-id-prefix": "rn"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "duration_ms": {
          "type": "integer"
        },
        "usage": {
          "$ref": "../common.schema.json#/$defs/Usage"
        },
        "error": {
          "$ref": "../common.schema.json#/$defs/Error"
        },
        "finish_reason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "error",
            "cancelled"
          ]
        }
      },
      "required": [
        "turn_id",
        "run_id",
        "status",
        "duration_ms"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/sys/usage.recorded.schema.json",
  "title": "usage.recorded",
  "description": "usage.recorded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "usage.recorded"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "turn",
            "eval",
            "tool",
            "embedding",
            "executor"
          ]
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "cached_tokens": {
          "type": "integer"
        },
        "cost_micros": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": [
            "CNY",
            "USD"
          ]
        },
        "price_version": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "cost_micros",
        "currency",
        "price_version"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

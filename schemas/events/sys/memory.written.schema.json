{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/sys/memory.written.schema.json",
  "title": "memory.written",
  "description": "memory.written",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "memory.written"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atom_id": {
          "type": "string",
          "x-id-prefix": "ma"
        },
        "tenant_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "preference",
            "episode",
            "profile",
            "skill"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "explicit_user",
            "assistant_inferred",
            "import",
            "migration"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "atom_id",
        "tenant_id",
        "agent_id",
        "kind",
        "source",
        "confidence",
        "evidence"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyopus.dev/schemas/events/intake/trigger.filtered.schema.json",
  "title": "trigger.filtered",
  "description": "trigger.filtered",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "event_id",
    "stream_id",
    "seq",
    "type",
    "ts",
    "tenant_id",
    "actor",
    "refs",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^(conv|ticket|src|user|sys):.+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "const": "trigger.filtered"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "$ref": "../common.schema.json#/$defs/Refs"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger_id": {
          "type": "string",
          "x-id-prefix": "tr"
        },
        "reason": {
          "type": "string",
          "enum": [
            "actor_not_allowed",
            "bot_not_allowed",
            "not_explicit",
            "rate_limited",
            "rule_denied",
            "self_message"
          ]
        },
        "rule_id": {
          "type": "string"
        }
      },
      "required": [
        "trigger_id",
        "reason"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
